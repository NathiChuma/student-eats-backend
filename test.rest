@baseUrl = http://localhost:3000

### Health check
GET {{baseUrl}}/health

### Student sign up
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
  "fullName": "Jane Student",
  "studentNumber": "12345678",
  "email": "jane@student.example.com",
  "password": "password123"
}

### Student sign in
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{
  "email": "jane@student.example.com",
  "password": "password123"
}

### Vendor sign up
POST {{baseUrl}}/vendors/signup
Content-Type: application/json

{
  "storeCode": "V001",
  "storeName": "Campus Grill",
  "email": "vendor@example.com",
  "phone": "0812345678",
  "category": "Fast Food",
  "password": "password123"
}

### Vendor sign in
POST {{baseUrl}}/vendors/signin
Content-Type: application/json

{
  "storeCode": "V001",
  "password": "password123"
}

### Get all vendors
GET {{baseUrl}}/vendors/getAllVendors

### Get vendor by id
GET {{baseUrl}}/vendors/REPLACE_WITH_VENDOR_ID

### Get vendor stats
GET {{baseUrl}}/vendors/getVendorStats/REPLACE_WITH_VENDOR_ID

### Add an order
POST {{baseUrl}}/orders/addOrder
Content-Type: application/json

{
  "id": "order_123",
  "userEmail": "jane@student.example.com",
  "vendorId": "REPLACE_WITH_VENDOR_ID",
  "vendorName": "Campus Grill",
  "items": [
    {
      "id": "item_1",
      "vendorId": "REPLACE_WITH_VENDOR_ID",
      "menuItemId": "menu_1",
      "menuItemName": "Cheeseburger",
      "price": 55,
      "quantity": 1
    }
  ],
  "totalAmount": 55,
  "status": "pending",
  "createdAt": "2026-07-26T10:00:00.000Z",
  "paymentReference": "ref_abc123"
}

### Get order by id
GET {{baseUrl}}/orders/order_123

### Get a user's orders
GET {{baseUrl}}/orders/getUserOrders/jane@student.example.com
