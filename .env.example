# Only PROJECT_ID, PRIVATE_KEY and CLIENT_EMAIL are actually read by the
# server (see src/firebase.ts) - the other fields in a downloaded Firebase
# service account JSON are unused. Paste values from Project Settings ->
# Service Accounts -> Generate new private key.
PROJECT_ID="your-project-id"
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR\nKEY\nHERE\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"

# Port the server listens on (default: 3000)
PORT=3000

# Origin allowed by CORS - set this to your deployed frontend's URL in production
CLIENT_ORIGIN="http://localhost:8080"
